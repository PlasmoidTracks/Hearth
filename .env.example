# Copy to .env and adjust. All values are optional; sensible defaults apply.
# Generate a real secret for production:  python -c "import secrets;print(secrets.token_hex(32))"

# --- HTTP binding (localhost only by default; front with Tailscale/TLS) ---
HEARTH_HOST=127.0.0.1
HEARTH_PORT=8080
# Family devices on the LAN: set HEARTH_HOST=0.0.0.0 (open your firewall for the port),
# and use HEARTH_COOKIE_SAMESITE=lax so a device reaching the app by LAN IP isn't blocked
# by Strict's cross-origin rule. See README "Access from another device on your LAN".

# --- Cookie / token signing (SET THIS IN PRODUCTION) ---
HEARTH_SECRET_KEY=
HEARTH_COOKIE_SECURE=false          # true when serving over HTTPS
HEARTH_COOKIE_SAMESITE=strict       # strict | lax | none  (lax is the LAN-exposure option)
HEARTH_SESSION_TTL_HOURS=12

# --- First-run admin bootstrap (leave password blank to auto-generate once) ---
HEARTH_BOOTSTRAP_ADMIN_USER=admin
HEARTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- llama.cpp / llama-server ---
# Prefer setting these in Admin → Model (Server binary path / Model path) — they're
# editable in the UI now. These env vars are only the fallback when the UI fields are blank.
HEARTH_USE_STUB_LLM=true            # false + (bin|base_url) => real model
HEARTH_LLAMA_SERVER_BIN=            # path to llama-server binary
HEARTH_LLAMA_MODEL_PATH=            # path to a .gguf model
# Optional vision projector for multimodal models (image attachments). Must be the
# mmproj-*.gguf that pairs with the model above; set it and Hearth passes --mmproj.
HEARTH_LLAMA_MMPROJ_PATH=           # e.g. /home/you/models/mmproj-Qwen2.5-VL-7B-Instruct-f16.gguf
HEARTH_LLAMA_BASE_URL=              # existing server base URL (skips launching)
HEARTH_LLAMA_PORT=8081              # port for the llama-server Hearth launches
HEARTH_LLAMA_JINJA=true             # --jinja: needed for Hermes/Llama3.1/Qwen tool calling
HEARTH_LLAMA_EXTRA_ARGS=            # raw extra CLI args, e.g. "--chat-template x.jinja --top-k 40"

# --- Workspace encryption at rest (opt-in) ---
# Files are encrypted (XChaCha20-Poly1305) on disk, decrypted in memory per access.
# Needs `cryptography`. Protects disks/backups — not the running server's RAM.
HEARTH_WORKSPACE_ENCRYPTION=false
HEARTH_WORKSPACE_ENC_KEY=           # 64 hex chars (python -c "import secrets;print(secrets.token_hex(32))")
HEARTH_WORKSPACE_ENC_PASS=          # or a passphrase (scrypt-derived; salted by HEARTH_SECRET_KEY)

# --- Tailscale / trusted-header SSO (optional) ---
HEARTH_TAILSCALE_SSO_ENABLED=false
HEARTH_TRUSTED_PROXY_IPS=           # comma list; only these may set identity headers

# --- Web access (web_search / web_fetch) ---
HEARTH_WEB_SEARCH_ENABLED=true
# The web-access MODE is an admin runtime setting (Admin → Tools → Web), not env:
#   off | search_and_fetch_safe (default, DuckDuckGo HTML + plain HTTP)
#   tor          — same over a local Tor SOCKS5 proxy  (pip install "httpx[socks]")
#   open_browser — operator's real Chrome via Selenium: full JS + logged-in cookies
#                  (pip install selenium; keep OFF on shared installs — the model can
#                   reach any site that browser session is logged into)

# --- Rate limiting / lockout ---
HEARTH_LOGIN_MAX_ATTEMPTS=8
HEARTH_LOGIN_LOCKOUT_SECONDS=900

# --- Optional: device helper URL for device tools (read-only folder/screenshot) ---
# Also editable in Admin → Tools → Device ("Device helper URL"), which wins over this.
# Until a helper runs somewhere, the device_* tools report that nothing is paired.
HEARTH_DEVICE_HELPER_URL=

# --- Streaming safety valve ---
# End a turn if the provider stream yields NOTHING for this many seconds (Abort always works).
HEARTH_STREAM_IDLE_TIMEOUT_S=300
HEARTH_STREAM_IDLE_GUARD=true       # false disables it; auto-off on Python < 3.11 (asyncio.timeout)


# --- Optional: image generation with Qwen Image (stable-diffusion.cpp `sd-cli`) ---
# These are deployment-level FALLBACKS; Admin → Images wins. The admin settings are the
# real interface — this is only for keeping paths out of the DB on a fresh install.
# Supported models: Qwen Image / Qwen Image 2.1 (three files, one folder). DEC-074.
HEARTH_DIFFUSION_CLI_BIN=           # e.g. /home/you/stable-diffusion.cpp/build/bin/sd-cli
HEARTH_DIFFUSION_MODEL_DIR=         # folder holding all three files; Hearth finds them by name
HEARTH_DIFFUSION_DIT=               #   qwen_image_2.1_Q8_0.gguf          -> --diffusion-model
HEARTH_DIFFUSION_LLM=               #   Qwen3VL-8B-Instruct-Q4_K_M.gguf   -> --llm
HEARTH_DIFFUSION_VAE=               #   diffusion_pytorch_model.safetensors -> --vae
HEARTH_DIFFUSION_BACKEND=           # blank = sd-cli auto-fit; 'cpu', or e.g. diffusion=vulkan1,vae=cpu

# --- Optional: image EDITING with Qwen Image Edit (same `sd-cli` binary) ---
# A second, independent model slot alongside generation. DEC-078. Editing feeds the input
# image as a reference (-r), samples at CFG ~2.5 with --flow-shift 3, and needs an Edit DiT
# + a Qwen2.5-VL text encoder (NOT the Qwen3-VL that generation uses) + the VAE. The CLI path
# falls back to HEARTH_DIFFUSION_CLI_BIN when blank — same executable, different files.
HEARTH_IMAGE_EDIT_CLI_BIN=          # blank = reuse HEARTH_DIFFUSION_CLI_BIN above
HEARTH_IMAGE_EDIT_MODEL_DIR=        # folder holding the Edit DiT + Qwen2.5-VL encoder + VAE
HEARTH_IMAGE_EDIT_DIT=              #   Qwen_Image_Edit-Q8_0.gguf           -> --diffusion-model
HEARTH_IMAGE_EDIT_LLM=              #   Qwen2.5-VL-7B-Instruct-Q8_0.gguf    -> --llm
HEARTH_IMAGE_EDIT_VAE=              #   qwen_image_vae.safetensors          -> --vae
HEARTH_IMAGE_EDIT_LLM_VISION=       #   optional, 2509 only: ...mmproj...gguf -> --llm_vision
HEARTH_IMAGE_EDIT_BACKEND=          # blank = sd-cli auto-fit; same semantics as generation
