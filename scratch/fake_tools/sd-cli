#!/usr/bin/env python3
"""Fake sd-cli faithful to examples/cli/main.cpp output naming:
snprintf(specifier, idx) applied verbatim, begin_idx 0 when %d present.
"""
import os, re, sys
argv = sys.argv[1:]
print("sd-cli fake args:", " ".join(argv))

def fmt(pattern, idx):
    def rep(m):
        return m.group(0).replace(m.group(1), "%d" % idx)
    # emulate: replace each (%<width>d) with snprintf of that specifier
    out = re.sub(r"(?<![^%])(%\d{0,3}d)", lambda m: m.group(0).replace(m.group(1), m.group(1) % idx), pattern) if False else None
    res = pattern
    while True:
        m = re.search(r"(%\d{0,3}d)", res)
        if not m: break
        spec = m.group(1)
        res = res[:m.start(1)] + (spec % idx) + res[m.end(1):]
    return res.replace("%%", "%")

out = prev = None
n = 1
for i, a in enumerate(argv):
    if a in ("-o", "--output"): out = argv[i+1]
    if a == "--preview-path": prev = argv[i+1]
    if a == "-b":
        try: n = int(argv[i+1])
        except ValueError: pass

if out and re.search(r"%\d{0,3}d", out):
    for k in range(n):
        p = fmt(out, k)
        with open(p, "wb") as f: f.write(b"\x89PNG\r\n\x1a\nFAKE" + str(k).encode())
elif out:
    if n > 1:
        for k in range(n):
            with open(f"{out}_{k}.png", "wb") as f: f.write(b"FAKE")
    else:
        with open(out, "wb") as f: f.write(b"\x89PNG\r\n\x1a\nFAKE")
if prev and re.search(r"%\d{0,3}d", prev):
    with open(fmt(prev, 0), "wb") as f: f.write(b"PREVIEWBYTES")
print("done")
